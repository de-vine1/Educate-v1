{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=EducateDb;Port=5432;Username=postgres;Password=devine"
  },
  "Jwt": {
    "Key": "your-secret-key-here-must-be-at-least-32-characters",
    "Issuer": "EducateAPI",
    "Audience": "EducateClient"
  },
  "Cors": {
    "AllowedOrigins": ["*"]
  },

  "Security": {
    "EncryptionKey": "your-32-character-encryption-key",
    "AuditRetentionDays": 365
  },

  "Paystack": {
    "SecretKey": "sk_test_3f38be1e116e02f9b2d078ca138812f900a42bfe ",
    "CallbackUrl": "http://localhost:3000/callback"
  },

  "NodeMailer": {
    "BaseUrl": "http://localhost:4000"
  },

  "App": {
    "BaseUrl": "https://educate.com",
    "SupportEmail": "support@educate.com"
  },

  "Google": {
    "ClientId": "your-google-client-id",
    "ClientSecret": "your-google-client-secret"
  },

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "post:/api/Auth/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "post:/api/Account/2fa/verify",
        "Period": "1m",
        "Limit": 5
      }
    ]
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/educate-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
